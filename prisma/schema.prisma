// Aftekasa — Prisma schema matching the modern Neon/PostgreSQL database
// App generates IDs via generateId(); raw SQL remains the source of truth for updated_at.

generator client {
  provider      = "prisma-client-js"
  engineType    = "binary"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id
  email                String    @unique
  passwordHash         String    @map("password_hash")
  name                 String
  role                 String    @default("STUDENT")
  balance              Decimal   @default(0) @db.Decimal(10, 2)
  grade                String?
  division             String?
  studyType            String?   @map("study_type")
  governorate          String?
  studentNumber        String?   @map("student_number")
  guardianNumber       String?   @map("guardian_number")
  currentSessionId     String?   @map("current_session_id")
  copyrightCode        String?   @map("copyright_code") @db.VarChar(10)
  teacherSubject       String?   @map("teacher_subject")
  teacherAvatarUrl     String?   @map("teacher_avatar_url")
  teacherHomepageOrder Int?      @map("teacher_homepage_order")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  categoriesCreated       Category[]                 @relation("CategoryCreatedBy")
  coursesCreated          Course[]                   @relation("CourseCreatedBy")
  coursesAssigned         Course[]                   @relation("CourseAssignedTeacher")
  enrollments             Enrollment[]
  activationCodesUsed     ActivationCode[]           @relation("ActivationCodeUsedBy")
  payments                Payment[]
  quizAttempts            QuizAttempt[]
  lessonProgress          LessonProgress[]
  lessonRatings           LessonRating[]
  homeworkSubmissions     HomeworkSubmission[]
  passwordChangeRequests  PasswordChangeRequest[]    @relation("PasswordChangeRequestUser")
  passwordChangeProcessed PasswordChangeRequest[]    @relation("PasswordChangeRequestProcessedBy")
  staffConversations      Conversation[]             @relation("ConversationStaff")
  studentConversations    Conversation[]             @relation("ConversationStudent")
  messagesSent            Message[]                  @relation("MessageSender")
  conversationReads       ConversationRead[]
  storePurchases          UserStorePurchase[]
  platformSubscriptions   UserPlatformSubscription[]

  @@index([role])
  @@index([teacherHomepageOrder])
}

model Category {
  id          String   @id
  name        String
  nameAr      String?  @map("name_ar")
  slug        String   @unique
  description String?
  imageUrl    String?  @map("image_url")
  order       Int      @default(0) @map("order")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz

  createdBy         User?              @relation("CategoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  courses           Course[]
  subscriptionPlans SubscriptionPlan[]

  @@index([createdById])
  @@index([order])
}

model Course {
  id                      String   @id
  title                   String
  titleAr                 String?  @map("title_ar")
  slug                    String   @unique
  description             String
  descriptionEn           String?  @map("description_en")
  shortDesc               String?  @map("short_desc") @db.VarChar(300)
  shortDescEn             String?  @map("short_desc_en") @db.VarChar(300)
  imageUrl                String?  @map("image_url")
  price                   Decimal  @default(0) @db.Decimal(10, 2)
  duration                String?
  level                   String?
  isPublished             Boolean  @default(false) @map("is_published")
  order                   Int      @default(0) @map("order")
  maxQuizAttempts         Int?     @map("max_quiz_attempts")
  categoryId              String?  @map("category_id")
  createdById             String?  @map("created_by_id")
  assignedTeacherId       String?  @map("assigned_teacher_id")
  acceptsHomework         Boolean  @default(false) @map("accepts_homework")
  excludeFromSubscription Boolean  @default(false) @map("exclude_from_subscription")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime @default(now()) @map("updated_at") @db.Timestamptz

  category              Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy             User?                  @relation("CourseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTeacher       User?                  @relation("CourseAssignedTeacher", fields: [assignedTeacherId], references: [id], onDelete: SetNull)
  lessons               Lesson[]
  liveStreams           LiveStream[]
  enrollments           Enrollment[]
  activationCodes       ActivationCode[]
  payments              Payment[]
  quizzes               Quiz[]
  quizCourseAssignments QuizCourseAssignment[]
  lessonProgress        LessonProgress[]
  lessonRatings         LessonRating[]
  homeworkSubmissions   HomeworkSubmission[]

  @@index([categoryId])
  @@index([createdById])
  @@index([assignedTeacherId])
  @@index([order])
  @@index([isPublished])
}

model Lesson {
  id                          String   @id
  courseId                    String   @map("course_id")
  title                       String
  titleAr                     String?  @map("title_ar")
  slug                        String
  content                     String?
  videoUrl                    String?  @map("video_url")
  pdfUrl                      String?  @map("pdf_url")
  duration                    Int?
  order                       Int      @default(0) @map("order")
  acceptsHomework             Boolean  @default(false) @map("accepts_homework")
  isPublished                 Boolean  @default(true) @map("is_published")
  homeworkMaterials           String?  @map("homework_materials")
  homeworkExplanationVideoUrl String?  @map("homework_explanation_video_url")
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                   DateTime @default(now()) @map("updated_at") @db.Timestamptz

  course                   Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  ratings                  LessonRating[]
  homeworkSubmissions      HomeworkSubmission[]
  activationCodeLessons    ActivationCodeLesson[]

  @@unique([courseId, slug])
  @@index([courseId])
  @@index([order])
}

model LessonProgress {
  id          String   @id
  userId      String   @map("user_id")
  /** No FK — may reference Lesson or legacy Chapter ids */
  lessonId    String   @map("lesson_id")
  courseId    String   @map("course_id")
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId, courseId])
  @@index([userId, courseId])
  @@index([lessonId])
}

model LessonRating {
  id        String   @id
  lessonId  String   @map("lesson_id")
  userId    String   @map("user_id")
  courseId  String   @map("course_id")
  rating    Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId])
  @@index([lessonId])
  @@index([courseId])
  @@index([userId])
}

model LiveStream {
  id              String   @id
  courseId        String   @map("course_id")
  title           String
  titleAr         String?  @map("title_ar")
  provider        String
  meetingUrl      String   @map("meeting_url")
  meetingId       String?  @map("meeting_id")
  meetingPassword String?  @map("meeting_password")
  scheduledAt     DateTime @map("scheduled_at") @db.Timestamptz
  description     String?
  order           Int      @default(0) @map("order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([scheduledAt])
}

model Enrollment {
  id         String   @id
  userId     String   @map("user_id")
  courseId   String   @map("course_id")
  enrolledAt DateTime @default(now()) @map("enrolled_at") @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model ActivationCode {
  id           String    @id
  courseId     String    @map("course_id")
  code         String    @unique
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  usedAt       DateTime? @map("used_at") @db.Timestamptz
  usedByUserId String?   @map("used_by_user_id")

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  usedBy  User?   @relation("ActivationCodeUsedBy", fields: [usedByUserId], references: [id], onDelete: SetNull)
  lessons ActivationCodeLesson[]
  quizzes ActivationCodeQuiz[]

  @@index([courseId])
  @@index([createdAt])
  @@index([usedByUserId])
}

model ActivationCodeLesson {
  activationCodeId String @map("activation_code_id")
  lessonId         String @map("lesson_id")

  activationCode ActivationCode @relation(fields: [activationCodeId], references: [id], onDelete: Cascade)
  lesson         Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([activationCodeId, lessonId])
  @@index([activationCodeId])
  @@index([lessonId])
}

model ActivationCodeQuiz {
  activationCodeId String @map("activation_code_id")
  quizId           String @map("quiz_id")

  activationCode ActivationCode @relation(fields: [activationCodeId], references: [id], onDelete: Cascade)
  quiz           Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@id([activationCodeId, quizId])
  @@index([activationCodeId])
  @@index([quizId])
}

model Payment {
  id        String   @id
  userId    String   @map("user_id")
  courseId  String   @map("course_id")
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
  @@index([createdAt])
}

model Quiz {
  id               String   @id
  courseId         String   @map("course_id")
  title            String
  order            Int      @default(0) @map("order")
  timeLimitMinutes Int?     @map("time_limit_minutes")
  quizType         String   @default("NORMAL") @map("quiz_type")
  parentQuizId     String?  @map("parent_quiz_id")
  /** Legacy camelCase column — kept so db push does not drop existing data */
  quizTypeCamel    String   @default("NORMAL") @map("quizType")
  /** Legacy camelCase column — kept so db push does not drop existing data */
  parentQuizIdCamel String? @map("parentQuizId")
  maxAttempts      Int?     @map("max_attempts")
  isPublished      Boolean  @default(true) @map("is_published")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz

  course                Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  parentQuiz            Quiz?                  @relation("QuizParent", fields: [parentQuizId], references: [id], onDelete: SetNull)
  remedialQuizzes       Quiz[]                 @relation("QuizParent")
  questions             Question[]
  attempts              QuizAttempt[]
  courseAssignments     QuizCourseAssignment[]
  activationCodeQuizzes ActivationCodeQuiz[]

  @@index([courseId])
  @@index([parentQuizId])
  @@index([order])
}

model QuizCourseAssignment {
  id        String   @id
  quizId    String   @map("quizId")
  courseId  String   @map("courseId")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([quizId, courseId])
  @@index([quizId])
  @@index([courseId])
}

model Question {
  id           String   @id
  quizId       String   @map("quiz_id")
  type         String
  questionText String   @map("question_text")
  order        Int      @default(0) @map("order")
  imageUrl     String?  @map("image_url")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz

  quiz    Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options QuestionOption[]

  @@index([quizId])
  @@index([order])
}

model QuestionOption {
  id         String   @id
  questionId String   @map("question_id")
  text       String
  isCorrect  Boolean  @default(false) @map("is_correct")
  position   Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model QuizAttempt {
  id             String   @id
  userId         String   @map("user_id")
  quizId         String   @map("quiz_id")
  score          Int?
  totalQuestions Int?     @map("total_questions")
  answersJson    String?  @map("answers_json")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId, quizId])
  @@index([userId])
  @@index([quizId])
}

model HomeworkSubmission {
  id             String    @id
  courseId       String    @map("course_id")
  userId         String    @map("user_id")
  lessonId       String?   @map("lesson_id")
  submissionType String    @map("submission_type")
  linkUrl        String?   @map("link_url")
  fileUrl        String?   @map("file_url")
  fileName       String?   @map("file_name")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  markedAt       DateTime? @map("marked_at") @db.Timestamptz

  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([userId])
  @@index([lessonId])
  @@index([createdAt])
}

model Conversation {
  id            String   @id
  staffUserId   String   @map("staff_user_id")
  studentUserId String   @map("student_user_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz

  staffUser   User               @relation("ConversationStaff", fields: [staffUserId], references: [id], onDelete: Cascade)
  studentUser User               @relation("ConversationStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
  messages    Message[]
  reads       ConversationRead[]

  @@unique([staffUserId, studentUserId])
  @@index([staffUserId])
  @@index([studentUserId])
}

model Message {
  id             String   @id
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  messageType    String   @map("message_type")
  content        String?
  fileUrl        String?  @map("file_url")
  fileName       String?  @map("file_name")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@index([senderId])
}

model ConversationRead {
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  lastReadAt     DateTime @default(now()) @map("last_read_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model StoreProduct {
  id          String   @id
  title       String
  description String   @default("")
  price       Decimal  @default(0) @db.Decimal(10, 2)
  costPrice   Decimal  @default(0) @map("cost_price") @db.Decimal(10, 2)
  imageUrl    String?  @map("image_url")
  pdfUrl      String?  @map("pdf_url")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz

  purchases UserStorePurchase[]

  @@index([isActive, sortOrder, createdAt])
}

model UserStorePurchase {
  id        String   @id
  userId    String   @map("user_id")
  productId String   @map("product_id")
  pricePaid Decimal  @default(0) @map("price_paid") @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  product StoreProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
}

model SubscriptionPlan {
  id           String   @id
  name         String
  description  String   @default("")
  imageUrl     String?  @map("image_url")
  durationKind String   @map("duration_kind")
  price        Decimal  @default(0) @db.Decimal(10, 2)
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  categoryId   String?  @map("category_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz

  category      Category?                  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subscriptions UserPlatformSubscription[]

  @@index([isActive, sortOrder])
  @@index([categoryId])
}

model UserPlatformSubscription {
  id        String   @id
  userId    String   @map("user_id")
  planId    String?  @map("plan_id")
  pricePaid Decimal  @default(0) @map("price_paid") @db.Decimal(10, 2)
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@index([planId])
}

model Review {
  id            String   @id
  text          String
  textEn        String?  @map("text_en")
  authorName    String   @map("author_name")
  authorTitle   String?  @map("author_title")
  authorTitleEn String?  @map("author_title_en")
  avatarLetter  String?  @map("avatar_letter")
  imageUrl      String?  @map("image_url")
  order         Int      @default(0) @map("order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@index([order])
}

model PasswordChangeRequest {
  id                       String    @id
  userId                   String    @map("user_id")
  newPasswordHash          String    @map("new_password_hash")
  requestedIdentifier      String?   @map("requested_identifier")
  requestedOldPassword     String?   @map("requested_old_password")
  requestedNewPasswordPlain String?  @map("requested_new_password_plain")
  status                   String    @default("pending")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz
  processedAt              DateTime? @map("processed_at") @db.Timestamptz
  processedById            String?   @map("processed_by_id")

  user        User  @relation("PasswordChangeRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  processedBy User? @relation("PasswordChangeRequestProcessedBy", fields: [processedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model HomepageSetting {
  id String @id @default("default")

  heroTemplate   String? @map("hero_template")
  teacherImageUrl String? @map("teacher_image_url")
  heroTitle      String? @map("hero_title")
  heroTitleEn    String? @map("hero_title_en")
  heroSlogan     String? @map("hero_slogan")
  heroSloganEn   String? @map("hero_slogan_en")
  platformName   String? @map("platform_name")
  platformNameEn String? @map("platform_name_en")
  headerLogoUrl  String? @map("header_logo_url")
  primaryColor   String? @map("primary_color")

  youtubeUrl   String? @map("youtube_url")
  linkedinUrl  String? @map("linkedin_url")
  whatsappUrl  String? @map("whatsapp_url")
  facebookUrl  String? @map("facebook_url")
  telegramUrl  String? @map("telegram_url")

  teamYoutubeUrl  String? @map("team_youtube_url")
  teamLinkedinUrl String? @map("team_linkedin_url")
  teamWhatsappUrl String? @map("team_whatsapp_url")
  teamFacebookUrl String? @map("team_facebook_url")
  teamTelegramUrl String? @map("team_telegram_url")

  socialRightLabel   String? @map("social_right_label")
  socialRightLabelEn String? @map("social_right_label_en")
  socialLeftLabel    String? @map("social_left_label")
  socialLeftLabelEn  String? @map("social_left_label_en")
  socialLeftEnabled  Boolean @default(true) @map("social_left_enabled")

  pageTitle   String? @map("page_title")
  pageTitleEn String? @map("page_title_en")

  heroBgPreset     String? @map("hero_bg_preset")
  heroBgCustomFrom String? @map("hero_bg_custom_from")
  heroBgCustomTo   String? @map("hero_bg_custom_to")

  heroFloatImage1 String? @map("hero_float_image_1")
  heroFloatImage2 String? @map("hero_float_image_2")
  heroFloatImage3 String? @map("hero_float_image_3")

  heroSliderImage1 String? @map("hero_slider_image_1")
  heroSliderImage2 String? @map("hero_slider_image_2")
  heroSliderImage3 String? @map("hero_slider_image_3")
  heroSliderImage4 String? @map("hero_slider_image_4")
  heroSliderImage5 String? @map("hero_slider_image_5")

  heroSliderCourseId1 String? @map("hero_slider_course_id_1")
  heroSliderCourseId2 String? @map("hero_slider_course_id_2")
  heroSliderCourseId3 String? @map("hero_slider_course_id_3")
  heroSliderCourseId4 String? @map("hero_slider_course_id_4")
  heroSliderCourseId5 String? @map("hero_slider_course_id_5")
  heroSliderIntervalMs Int?   @map("hero_slider_interval_ms")

  hero3Title               String? @map("hero3_title")
  hero3TitleEn             String? @map("hero3_title_en")
  hero3Subtitle            String? @map("hero3_subtitle")
  hero3SubtitleEn          String? @map("hero3_subtitle_en")
  hero3PhoneImageUrl       String? @map("hero3_phone_image_url")
  hero3PhoneBgColor        String? @map("hero3_phone_bg_color")
  hero3StoreBadge1ImageUrl String? @map("hero3_store_badge_1_image_url")
  hero3StoreBadge1Link     String? @map("hero3_store_badge_1_link")
  hero3StoreBadge2ImageUrl String? @map("hero3_store_badge_2_image_url")
  hero3StoreBadge2Link     String? @map("hero3_store_badge_2_link")

  footerTitle       String? @map("footer_title")
  footerTitleEn     String? @map("footer_title_en")
  footerTagline     String? @map("footer_tagline")
